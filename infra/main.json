              "type": "string",
              "defaultValue": "PT5M",
              "allowedValues": [
                "PT5M"
              ],
              "metadata": {
                "description": "ISO 8601 interval controlling how often the query is evaluated."
              }
            },
            "windowSize": {
              "type": "string",
              "defaultValue": "PT5M",
              "allowedValues": [
                "PT5M",
                "PT10M",
                "PT30M"
              ],
              "metadata": {
                "description": "ISO 8601 interval controlling the query lookback window."
              }
            },
            "autoMitigate": {
              "type": "bool",
              "metadata": {
                "description": "Whether Azure Monitor automatically resolves a fired alert after the condition clears."
              }
            },
            "dimensions": {
              "type": "array",
              "defaultValue": [],
              "metadata": {
                "description": "Solution-owned dimensions emitted by the query and used to split alert instances."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource tags applied to the scheduled-query rule."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Insights/scheduledQueryRules",
              "apiVersion": "2023-12-01",
              "name": "[parameters('alertRuleName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "displayName": "[parameters('displayName')]",
                "description": "[parameters('alertDescription')]",
                "severity": "[parameters('severity')]",
                "enabled": true,
                "evaluationFrequency": "[parameters('evaluationFrequency')]",
                "windowSize": "[parameters('windowSize')]",
                "scopes": [
                  "[parameters('workspaceResourceId')]"
                ],
                "criteria": {
                  "allOf": [
                    {
                      "query": "[parameters('query')]",
                      "timeAggregation": "Count",
                      "operator": "GreaterThan",
                      "threshold": 0,
                      "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                      },
                      "dimensions": "[parameters('dimensions')]"
                    }
                  ]
                },
                "autoMitigate": "[parameters('autoMitigate')]",
                "actions": {
                  "actionGroups": [
                    "[parameters('actionGroupResourceId')]"
                  ]
                }
              }
            }
          ],
          "outputs": {
            "alertRuleResourceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Insights/scheduledQueryRules', parameters('alertRuleName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Automation/automationAccounts', variables('resolvedAutomationAccountName'))]"
      ]
    }
  ],
  "outputs": {
    "AUTOMATION_ACCOUNT_NAME": {
      "type": "string",
      "value": "[variables('resolvedAutomationAccountName')]"
    },
    "AUTOMATION_PRINCIPAL_ID": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Automation/automationAccounts', variables('resolvedAutomationAccountName')), '2024-10-23', 'full').identity.principalId]"
    },
    "MAIN_RUNBOOK_NAME": {
      "type": "string",
      "value": "[variables('mainRunbookName')]"
    },
    "VALIDATE_CONNECTION_RUNBOOK_NAME": {
      "type": "string",
      "value": "[variables('validateConnectionRunbookName')]"
    },
    "VALIDATE_CONFIGURATION_RUNBOOK_NAME": {
      "type": "string",
      "value": "[variables('validateConfigurationRunbookName')]"
    },
    "EXCHANGE_ORGANIZATION_VARIABLE_NAME": {
      "type": "string",
      "value": "[variables('exchangeOrganizationVariableName')]"
    },
    "OPERATIONAL_ALERTS_ENABLED": {
      "type": "bool",
      "value": "[parameters('operationalAlertsEnabled')]"
    }
  }
}