    "resolvedAutomationAccountName": "[if(empty(parameters('automationAccountName')), format('aaaudit{0}', variables('automationNameSuffix')), parameters('automationAccountName'))]",
    "tags": {
      "workload": "advanced-auditing",
      "environment": "[toLower(parameters('environmentName'))]",
      "managedBy": "azd"
    }
  },
