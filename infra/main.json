  "variables": {
    "$fxv#0": "AzureDiagnostics\n| where ResourceProvider == \"MICROSOFT.AUTOMATION\" and Category == \"JobLogs\"\n| where _ResourceId =~ \"__AUTOMATION_ACCOUNT_ID__\"\n| where ResultType in (\"Failed\", \"Stopped\", \"Suspended\")\n| project TimeGenerated, RunbookName_s, JobId_g, ResultType, _ResourceId\n",
    "$fxv#1": "AzureDiagnostics\n| where ResourceProvider == \"MICROSOFT.AUTOMATION\" and Category == \"JobStreams\" and StreamType_s == \"Output\"\n| where _ResourceId =~ \"__AUTOMATION_ACCOUNT_ID__\" and RunbookName_s == \"Enable-AdvancedAuditing\"\n| extend signal = parse_json(ResultDescription)\n| where tostring(signal.kind) == \"advancedAuditing.retentionSetup\" and tostring(signal.schemaVersion) == \"1.0\"\n| extend status = iff(isnotempty(tostring(signal.accountId)) and tolower(tostring(signal.accountId)) == tolower(_ResourceId), tostring(signal.status), \"unknown\")\n| where status in (\"degraded\", \"stale\", \"unknown\")\n| project TimeGenerated, RunbookName_s, JobId_g, status, _ResourceId\n",
    "runtimeEnvironmentName": "PowerShell-76-AdvancedAuditing",
